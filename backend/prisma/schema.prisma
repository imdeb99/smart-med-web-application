// SMART-MED Prisma schema
// Database hosted on Supabase. The app uses the pooled connection (DATABASE_URL,
// port 6543) at runtime; migrations use the direct connection (DIRECT_URL, port 5432).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AppointmentType {
  VIDEO
  IN_PERSON
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SampleCollectionStatus {
  REQUESTED
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum AmbulanceType {
  BASIC
  ICU
  FREEZER
}

enum AmbulanceStatus {
  AVAILABLE
  BUSY
}

enum AmbulanceBookingStatus {
  REQUESTED
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum PaymentRelatedType {
  APPOINTMENT
  SAMPLE_COLLECTION
  AMBULANCE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  avatarUrl    String?
  role         Role     @default(PATIENT)
  createdAt    DateTime @default(now())

  doctorProfile     DoctorProfile?
  patientProfile    PatientProfile?
  appointments      Appointment[]      @relation("PatientAppointments")
  healthRecords     HealthRecord[]
  reviews           Review[]
  sampleCollections SampleCollection[]
  ambulanceBookings AmbulanceBooking[]
  payments          Payment[]
}

model DoctorProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bmdcId             String             @unique
  specialty          String
  bio                String?
  consultationFee    Float
  qualifications     String?
  experienceYears    Int?
  location           String?
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())

  appointments   Appointment[]
  healthRecords  HealthRecord[]
  reviews        Review[]
  dailyCapacities DailyCapacity[]
}

model PatientProfile {
  id      String  @id @default(uuid())
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  address String?
  dob     DateTime?
  gender  String?
}

model Appointment {
  id          String            @id @default(uuid())
  patientId   String
  patient     User              @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId    String
  doctor      DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  type        AppointmentType
  status      AppointmentStatus @default(PENDING)
  createdAt   DateTime          @default(now())

  // Daily Capacity Booking (optional — only set for capacity-based bookings).
  // Nullable so legacy slot-based appointments remain untouched.
  tokenNumber      Int?
  estimatedTime    DateTime?
  dailyCapacityId  String?
  dailyCapacity    DailyCapacity? @relation(fields: [dailyCapacityId], references: [id], onDelete: SetNull)

  healthRecord HealthRecord?
}

model DailyCapacity {
  id             String   @id @default(uuid())
  doctorId       String
  doctor         DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date           DateTime @db.Date
  totalCapacity  Int
  startTime      String
  avgDurationMin Int      @default(10)
  createdAt      DateTime @default(now())

  appointments    Appointment[]
  overrideLogs    CapacityOverrideLog[]

  @@unique([doctorId, date])
}

model CapacityOverrideLog {
  id                String        @id @default(uuid())
  dailyCapacityId   String
  dailyCapacity     DailyCapacity @relation(fields: [dailyCapacityId], references: [id], onDelete: Cascade)
  adminId           String
  previousCapacity  Int
  newCapacity       Int
  reason            String?
  createdAt         DateTime      @default(now())
}

model HealthRecord {
  id               String   @id @default(uuid())
  appointmentId    String   @unique
  appointment      Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId        String
  patient          User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  prescriptionText String
  notes            String?
  createdAt        DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId String
  patient   User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([doctorId, patientId])
}

model LabAssistant {
  id    String  @id @default(uuid())
  name  String
  phone String?
  area  String?

  sampleCollections SampleCollection[]
}

model SampleCollection {
  id             String                @id @default(uuid())
  patientId      String
  patient        User                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  labAssistantId String?
  labAssistant   LabAssistant?         @relation(fields: [labAssistantId], references: [id], onDelete: SetNull)
  testName       String
  address        String
  scheduledAt    DateTime
  status         SampleCollectionStatus @default(REQUESTED)
  createdAt      DateTime              @default(now())
}

model Ambulance {
  id         String          @id @default(uuid())
  driverName String
  vehicleNo  String          @unique
  type       AmbulanceType
  status     AmbulanceStatus @default(AVAILABLE)

  bookings AmbulanceBooking[]
}

model AmbulanceBooking {
  id             String                 @id @default(uuid())
  patientId      String
  patient        User                   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  ambulanceId    String?
  ambulance      Ambulance?             @relation(fields: [ambulanceId], references: [id], onDelete: SetNull)
  pickupLocation String
  dropLocation   String
  type           AmbulanceType
  status         AmbulanceBookingStatus @default(REQUESTED)
  requestedAt    DateTime              @default(now())
}

model Payment {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedType   PaymentRelatedType
  relatedId     String
  amount        Float
  method        String
  status        PaymentStatus       @default(PENDING)
  transactionId String?
  createdAt     DateTime            @default(now())
}
