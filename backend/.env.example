# SMART-MED Backend environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (Supabase) — pooled connection (port 6543), used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# PostgreSQL (Supabase) — direct connection (port 5432), used ONLY for migrations
# (npx prisma migrate dev uses this connection)
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# JWT signing secret — generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API listens on
PORT=4000

# Allowed CORS origin (the React frontend dev server)
CLIENT_ORIGIN="http://localhost:5173"
